APP_NAME=Laravel
APP_ENV=local
# OpenRouter is the initial AI gateway. Credentials and model routing are
# managed in Admin > AI Settings; this environment key is a compatibility
# fallback for bootstrapping and emergency recovery.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=45
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=*
APP_OPTIMIZE_ON_BOOT=true
RUN_MIGRATIONS=false

META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI="${APP_URL}/merchant/social/meta/callback"
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
META_GRAPH_API_VERSION="${META_GRAPH_VERSION}"
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_CONFIGURATION_ID=
META_LOGIN_TYPE=instagram
META_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages

WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_CONFIGURATION_ID="${META_CONFIGURATION_ID}"
WHATSAPP_CLOUD_APP_SECRET="${META_CLIENT_SECRET}"
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN="${META_WEBHOOK_VERIFY_TOKEN}"
WHATSAPP_CLOUD_GRAPH_VERSION="${META_GRAPH_VERSION}"
WHATSAPP_CLOUD_GRAPH_API_BASE_URL="${META_GRAPH_API_BASE_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=takeer_admin
GRAFANA_PORT=3333

DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=5432
DB_DATABASE=takeerms
DB_USERNAME=postgres
DB_PASSWORD=takeerms

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
HORIZON_PATH=admin/horizon
HEALTH_SNAPSHOT_RETENTION_DAYS=7
PUSHER_APP_ID=takeer-local
PUSHER_APP_KEY=takeer-key
PUSHER_APP_SECRET=takeer-secret
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=localhost
PUSHER_PORT=8081
PUSHER_SCHEME=http
VITE_BROADCAST_ENABLED=true
VITE_BROADCAST_DRIVER=pusher
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
FILESYSTEM_DISK=s3
PUBLIC_FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=2100
REDIS_QUEUE_BLOCK_FOR=5

CACHE_STORE=redis
CACHE_PREFIX=takeer_cache
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_PREFIX=takeer:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=takeer_minio
AWS_SECRET_ACCESS_KEY=takeer_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=takeer-media
AWS_PRIVATE_BUCKET=takeer-media
AWS_PRIVATE_URL=http://localhost:9000/takeer-media
AWS_PUBLIC_BUCKET=takeer-media
AWS_PUBLIC_URL=http://localhost:9000/takeer-media
AWS_ENDPOINT=http://localhost:9000
AWS_TEMPORARY_ENDPOINT=http://localhost:9000
AWS_TEMPORARY_URL=http://localhost:9000/takeer-media
AWS_USE_PATH_STYLE_ENDPOINT=true

FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT=15000

SELCOM_GATEWAY_ENABLED=false
AZAMPAY_GATEWAY_ENABLED=true
FLUTTERWAVE_GATEWAY_ENABLED=false

# AzamPay sandbox. Replace these URLs and credentials with production values
# when Takeer is approved to go live; application code does not need to change.
AZAMPAY_AUTHENTICATOR_BASE_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_APP_NAME=Takeer
AZAMPAY_TOKEN=
# Provider-contract field order used to verify callback signatures.
AZAMPAY_CALLBACK_SIGNATURE_FIELDS=
LIVE_GATEWAY_CHECKOUT=false
SELCOM_SIMULATE=true
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
SELCOM_VENDOR_PIN=
SELCOM_SENDER_ACCOUNT=
SELCOM_SENDER_NAME="${APP_NAME}"
SELCOM_SENDER_MSISDN=
SELCOM_PAYOUT_CALLBACK_URL="${APP_URL}/api/payments/selcom/payout-callback"

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY=

# Photo-based virtual try-on. Use `http` with a compatible provider in production.
TRY_ON_DRIVER=fake
TRY_ON_ENDPOINT=
TRY_ON_API_KEY=
TRY_ON_TIMEOUT=180
TRY_ON_STORAGE_DISK=local
TRY_ON_SESSION_TTL_HOURS=24
TRY_ON_MAX_PORTRAIT_MB=10
